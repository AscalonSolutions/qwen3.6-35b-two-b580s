# Copy this file to .env and edit the three values below.

# The model file you downloaded into the ./models folder (step 4 of the README).
MODEL_FILE=Qwen_Qwen3.6-35B-A3B-IQ4_XS.gguf

# Context window in tokens.
#   32768 = tested default (a very long chat or ~80 pages of text)
#   65536 = tested maximum for two 12 GB cards
# Larger numbers need more VRAM. See "How much context can I use?"
# in the README before raising this.
CONTEXT=32768

# The port the server answers on.
PORT=8080

# Your system's "render" group number. Find it by running:
#   getent group render
# and copying the number after the second colon (render:x:993: or render:x:993:yourname -> 993).
RENDER_GID=993
